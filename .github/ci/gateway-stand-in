#!/usr/bin/perl
# A stand-in for the Lattice gateway on the desktop, for the guest of .github/ci/openbsd.
# It answers a stranger as the gateway does: GET with Accept text/html goes to the sign-in page,
# and any other request, a WebSocket upgrade too, is told to sign in.
#   perl gateway-stand-in ADDRESS PORT
use strict;
use warnings;
use IO::Socket::INET;

my ($address, $port) = @ARGV;
my $server = IO::Socket::INET->new(LocalAddr => $address, LocalPort => $port, Listen => 16, ReuseAddr => 1)
	or die "listen on $address:$port: $!\n";
$SIG{CHLD} = 'IGNORE';
while (my $client = $server->accept) {
	if (fork) {
		close $client;
		next;
	}
	my ($first, %header) = (scalar <$client>);
	while (my $line = <$client>) {
		$line =~ s/\r?\n\z//;
		last if $line eq '';
		$header{lc $1} = $2 if $line =~ /^([^:]+):\s*(.*)$/;
	}
	if (($first // '') =~ /^GET / && ($header{accept} // '') =~ m{text/html}) {
		print $client "HTTP/1.1 303 See Other\r\nLocation: /__gateway/login?next=/\r\nContent-Length: 0\r\nConnection: close\r\n\r\n";
	} else {
		my $body = '{"error":"sign_in_required"}';
		printf $client "HTTP/1.1 401 Unauthorized\r\nContent-Type: application/json\r\nContent-Length: %d\r\nConnection: close\r\n\r\n%s",
			length $body, $body;
	}
	close $client;
	exit 0;
}
