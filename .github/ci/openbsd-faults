#!/bin/sh
# shellcheck disable=SC2034,SC2154 # bad, drift and dkim_key belong to openbsd-guest, which sources this file.
# Sourced by openbsd-guest. Each group injects faults that do not touch each other, runs test.sh once,
# and requires exactly the expected checks to fail. Then it undoes the faults. A clean run ends the list.
bad=0
pf_fault() {
	{ cat /etc/pf.conf; printf '%s\n' "$@"; } > /tmp/pf.fault && pfctl -f /tmp/pf.fault
}
alert_restart() { rcctl restart syslogd > /dev/null; }

# Group 1: sshd, keys, cron, the VPN and accounting.
keep /etc/ssh/sshd_config "/home/admin/.ssh/authorized_keys"
crontab -l > /tmp/root.cron
{ cat /tmp/root.cron; echo '0 0 * * * /usr/local/sbin/health-check'; } | crontab -
sed -i -e 's/^PermitRootLogin no/PermitRootLogin yes/' -e 's/^AuthenticationMethods publickey/AuthenticationMethods any/' -e '/ForceCommand/d' -e '/AllowTcpForwarding/d' /etc/ssh/sshd_config
echo 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIC9ZbYqMCeOXp2iU4GQvDMNw3d8V6t1sHk2Jj1sYqXvH anywhere' >> /home/admin/.ssh/authorized_keys
peer=$(ifconfig wg0 | awk '$1 == "wgpeer" { print $2; exit }')
ifconfig wg0 -wgpeer "${peer}"
sysctl -q net.inet.ip.forwarding=0
accton
expect 'sshd, keys, cron, VPN and accounting faults' "${drift}
