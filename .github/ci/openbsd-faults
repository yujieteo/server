want=$(printf '%s\nTLS: version 1.2 is refused\nVPN: the resolver blocks a listed name\nVPN: the resolver answers for other names\n' "${inside_only}" | sort)
[ "$(outside)" = "${want}" ] && echo 'proved   outside: relayd takes TLS 1.2, the VPN resolver blocks nothing and fails others' ||
	{ echo 'UNPROVED outside: relayd takes TLS 1.2, the VPN resolver blocks nothing and fails others'; bad=$((bad + 1)); }
