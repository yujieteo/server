# The outside set, from the guest to its own address. Four checks fail with no fault: pf skips the guest's
# own traffic, so port 22 answers; the certificate lasts a day; DNS holds the live server's TLSA record;
# and /health.txt counts the guest's refused mail.
outside() { sh test.sh --outside "${web}" 2>&1 | sed -n 's/^FAIL //p' | sort; }
inside_only=$(printf '%s\n' 'address: port 22 is closed' 'TLS: the certificate lasts 14 days or more' \
	'DNS: the TLSA record matches the TLS key' 'health: the daily check ran in the last 26 hours, and no mail is stuck or lost' | sort)
[ "$(outside)" = "${inside_only}" ] && echo 'proved   outside: only the four guest checks fail' ||
	{ echo 'UNPROVED outside: other checks fail with no fault'; bad=$((bad + 1)); }
