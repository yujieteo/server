[ "$(sh test.sh --outside 192.0.2.1 2>&1 | sed -n 's/^FAIL //p' | sort)" = "${dead}" ] && echo 'proved   outside: an address with no server fails' ||
	{ echo 'UNPROVED outside: an address with no server fails'; bad=$((bad + 1)); }

# install.sh tests each rendered config with its own daemon. A broken source config must stop it.
for f in ssh/sshd_config httpd.conf relayd.conf mail/smtpd.conf unbound.conf acme-client.conf pf.conf; do
	src=etc/${f#*/}
	keep "${src}"
