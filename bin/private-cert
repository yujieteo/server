#!/bin/sh
# Get or renew the certificate of mac.lavish.teoyujie.org, desk.lavish.teoyujie.org and
# fh.teoyujie.org (relayd.conf). For a new certificate, reload httpd and relayd. cron runs it
# each hour, and install.sh runs it 1 time. Let's Encrypt checks the names on the public address,
# so it does nothing until the public DNS has the A records of the 3 names (README.md).
d=teoyujie.org
ip4=$(ifconfig egress | awk '$1 == "inet" { print $2; exit }')
for n in mac.lavish desk.lavish fh; do [ "$(dig +short @9.9.9.9 $n.$d A)" = "$ip4" ] || exit 0; done
acme-client mac.lavish.$d
case $? in
0) rcctl reload httpd >/dev/null && rcctl restart relayd >/dev/null ;;
2) ;;
*) exit 1 ;;
esac
