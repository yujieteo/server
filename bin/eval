#!/usr/bin/env bash
set -u
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "${root}" || exit 1
out=${EVAL_OUT:-}
failed=0

record() {
  [[ -n "${out}" ]] || return 0
  mkdir -p "${out}"
  printf '%s\n' "$2" > "${out}/$1.out"
}

report() {
  if [[ "$2" = ok ]]; then
    echo "PASS $1"
  else
    echo "FAIL $1: $3"
    failed=$((failed + 1))
  fi
}

lint_case() {
  local file=$1 expect=$2 got rules
  got=$(bin/rules "${file}" 2>&1)
  rules=$(awk -F': ' 'NF > 2 && !seen[$2]++ { printf "%s ", $2 }' <<< "${got}")
  record "lint-${file//\//_}" "${got}"
  if [[ "${expect}" = ok ]] && [[ -z "${got}" ]]; then report "lint ${file}" ok
  elif [[ "${expect}" != ok ]] && printf '%s' "${rules}" | grep -qw "${expect}"; then report "lint ${file}" ok
  else report "lint ${file}" bad "expected ${expect}, got [${rules:-nothing}]"; fi
}

run_lint() {
  local file expect
  while IFS=$'\t' read -r file expect; do
    [[ -n "${file}" ]] && lint_case "${file}" "${expect}"
  done < evals/lint.tsv
}

intent_case() {
  local id=$1 script=$2 got tail3
  got=$(bash "${script}" 2>&1)
  tail3=$(awk '{ l[NR] = $0 } END { for (i = (NR > 3 ? NR - 2 : 1); i <= NR; i++) printf "%s ", l[i] }' <<< "${got}")
  record "intent-${id}" "${got}"
  if [[ "${got##*$'\n'}" = OK ]]; then report "intent ${id}" ok
  else report "intent ${id}" bad "${tail3}"; fi
}

run_intent() {
  local script
  for script in evals/intent/*.sh; do
    [[ -f "${script}" ]] && intent_case "$(basename "${script}" .sh)" "${script}"
  done
}

run_lint
[[ -n "${out}" ]] || run_intent
echo "${failed} failed"
[[ "${failed}" -eq 0 ]]
