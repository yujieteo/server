#!/bin/sh
set -eu
d=/var/unbound/etc
ftp -MVo $d/hosts.new https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts
awk '$1 == "0.0.0.0" && $2 ~ /^[a-z0-9_-]+(\.[a-z0-9_-]+)*\.[a-z]+$/ { print "local-zone: \"" $2 ".\" always_nxdomain" }' \
	$d/hosts.new | sort -u > $d/blocklist.new
rm $d/hosts.new
[ "$(wc -l < $d/blocklist.new)" -gt 10000 ] || { echo "blocklist too short, not changed"; exit 1; }
mv $d/blocklist.new $d/blocklist.conf
unbound-control -q reload
