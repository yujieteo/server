#!/usr/bin/env bash
set -u
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
. "${root}/rules.conf"

excluded() {
  local p
  for p in ${vendor} ${ungraded} evals/lint evals/intent; do
    case "$1" in "${p}"|"${p}"/*) return 0 ;; *) ;; esac
  done
  return 1
}

files() {
  if [[ "$#" -gt 0 ]]; then printf '%s\n' "$@"; return; fi
  local listed
  listed=$(git -C "${root}" ls-files -co --exclude-standard '*.md')
  while IFS= read -r f; do
    excluded "${f}" || echo "${f}"
  done <<< "${listed}"
}

main() {
  local f g bad=0 list
  list=$(files "$@")
  while IFS= read -r f; do
    [[ -n "${f}" ]] || continue
    g=$(awk -f "${root}/bin/awk/grade.awk" "${root}/${f}")
    if awk -v g="${g}" -v m="${grade_max}" 'BEGIN { exit !(g >= m) }'; then
      echo "${f}: reading grade ${g}, limit under ${grade_max}"
      bad=1
    elif [[ -n "${MDGRADE_ALL:-}" ]]; then
      echo "${f}: ${g}"
    fi
  done <<< "${list}"
  exit "${bad}"
}

main "$@"
