#!/bin/sh
set -eu
cd "$(dirname "$0")"
[ -s /etc/hostname.wg0 ] || { echo 'WireGuard config is missing; no install.' >&2; exit 1; }
[ ! -e /etc/hostname.wg0.new ] || { echo 'WireGuard has a pending change; no install.' >&2; exit 1; }
ifconfig wg0 2>/dev/null | grep -q 'flags=.*<.*UP' || { echo 'wg0 is not up; no install.' >&2; exit 1; }
work=$(mktemp -d)
trap 'rm -rf "${work}"' EXIT HUP INT TERM
umask 077
sh ./wg-config > "${work}/wg0"
cmp -s "${work}/wg0" /etc/hostname.wg0 || { echo 'WireGuard config would change; no install.' >&2; exit 1; }
echo 'WireGuard preflight passed: config bytes match and wg0 exists.'
