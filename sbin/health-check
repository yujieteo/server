#!/bin/sh
d=teoyujie.org
ip4=$(ifconfig egress | awk '$1 == "inet" { print $2 }')
ip6=$(ifconfig egress | awk '$1 == "inet6" && $2 !~ /^fe80/ { print $2 }')
less_than_30_days_away() { [ $(($(date -j -f %Y-%m-%d "$1" +%s) - $(date +%s))) -lt 2592000 ]; }

df -kl | awk 'NR > 1 && $5 + 0 > 85 { print "disk " $6 " is " $5 " full" }'
rcctl ls failed | sed 's/^/not running: /'
syspatch -c 2>&1 | sed 's/^/patch not installed: /'
openssl x509 -checkend 1209600 -noout -in /etc/ssl/$d.fullchain.pem >/dev/null ||
	echo "the certificate ends in less than 14 days"

rdap_end=$(ftp -MVo - https://rdap.publicinterestregistry.org/rdap/domain/$d | tr -d ' \t\n' |
	sed -n 's/.*"eventAction":"expiration","eventDate":"\([0-9-]*\)T.*/\1/p')
if [ -z "$rdap_end" ]; then
	echo "domain expiry: no answer from RDAP"
elif less_than_30_days_away "$rdap_end"; then
	echo "the domain ends on $rdap_end: renew it at Gandi"
fi

e=$(sed -n 's/^Expires: \([0-9-]*\)T.*/\1/p' /var/www/htdocs/server/.well-known/security.txt)
less_than_30_days_away "$e" && echo "security.txt ends on $e: change Expires in the server repo and run apply"

quad9() { dig +short @9.9.9.9 $d "$1" | sort | tr '\n' ' '; }
[ "$(quad9 NS)" = "ns-126-c.gandi.net. ns-130-a.gandi.net. ns-225-b.gandi.net. " ] || echo "NS is now: $(quad9 NS)"
[ "$(quad9 MX)" = "10 $d. " ] || echo "MX is now: $(quad9 MX)"
[ "$(quad9 A)" = "$ip4 " ] || echo "A is now: $(quad9 A)"
[ -n "$(quad9 AAAA)" ] || echo "AAAA is now empty"
for a in $(quad9 AAAA); do echo "$ip6" | grep -qx "$a" || echo "AAAA is now: $a"; done

spamhaus_zen_answer=$(dig +short @127.0.0.1 "$(echo "$ip4" | awk -F. '{ print $4 "." $3 "." $2 "." $1 }')".zen.spamhaus.org)
case $spamhaus_zen_answer in
"") ;;
127.255.255.*) echo "Spamhaus refused the query: $spamhaus_zen_answer" ;;
*) echo "$ip4 is on Spamhaus ZEN: $spamhaus_zen_answer" ;;
esac

ct_last_id_file=/var/db/ct-last-id
key=$(openssl pkey -in /etc/ssl/private/$d.key -pubout -outform DER | sha256)
last=$(cat $ct_last_id_file 2>/dev/null)
ftp -MVo - "https://api.certspotter.com/v1/issuances?domain=$d&include_subdomains=true${last:+&after=$last}" |
	tr -d ' \t"[]{}\n' | tr ',' '\n' | awk -F: -v key="$key" -v s="$ct_last_id_file" -v new="${last:+yes}" '
	$1 == "id" { id = $2 }
	$1 == "cert_sha256" { cert = $2 }
	$1 == "pubkey_sha256" && $2 != key && new { print "certificate not made by this server: https://crt.sh/?q=" cert }
	END { if (id) print id > s }'
