#!/bin/sh
d=teoyujie.org
ip4=$(ifconfig egress | awk '$1 == "inet" { print $2 }')
ip6=$(ifconfig egress | awk '$1 == "inet6" && $2 !~ /^fe80/ { print $2 }')
less_than_30_days_away() { [ $(($(date -j -f %Y-%m-%d "$1" +%s) - $(date +%s))) -lt 2592000 ]; }

df -kl | awk 'NR > 1 && $5 + 0 > 85 { print "disk " $6 " is " $5 " full" }'
rcctl ls failed | sed 's/^/not running: /'
pfctl -si | grep -q '^Status: Enabled' || echo "the firewall is off"
pfctl -sl | awk '$1 == "outbound" { n += $3 } END { if (n) print "pf blocked " n " outbound packets of a confined user since its rules loaded: tcpdump -ner /var/log/pflog outbound, then pfctl -f /etc/pf.conf" }'
# Process accounting marks a program that the kernel killed for its pledge (P) or kept from a file outside its unveil (U).
for f in /var/account/acct.0 /var/account/acct; do lastcomm -f $f perl; done 2>/dev/null |
	awk '$2 ~ /[PU]/ && $3 == "_feed" { n++ } END { if (n) print n " runs of a feed job broke their limits in the last two days: lastcomm perl" }'
ifconfig wg0 2>/dev/null | grep -q 'flags=.*<.*UP' || echo "wg0 is down: SSH is unreachable"
stuck=$(smtpctl show queue | awk -F'|' -v now="$(date +%s)" '$8 < now - 21600 { n++ } END { print n + 0 }')
[ "$stuck" -eq 0 ] || echo "$stuck mails have waited in the queue for over 6 hours"
lost=$(zcat -f /var/log/maillog.0.gz /var/log/maillog 2>/dev/null | grep -c 'mta delivery.*result="PermFail"')
[ "$lost" -eq 0 ] || echo "$lost mails were refused for good since yesterday: grep PermFail /var/log/maillog"
syspatch -c 2>&1 | sed 's/^/patch not installed: /'
openssl x509 -checkend 1209600 -noout -in /etc/ssl/$d.fullchain.pem >/dev/null ||
	echo "the certificate ends in less than 14 days"

rdap_end=$(ftp -MVo - https://rdap.publicinterestregistry.org/rdap/domain/$d | tr -d ' \t\n' |
	sed -n 's/.*"eventAction":"expiration","eventDate":"\([0-9-]*\)T.*/\1/p')
if [ -z "$rdap_end" ]; then
	echo "domain expiry: no answer from RDAP"
elif less_than_30_days_away "$rdap_end"; then
	echo "the domain ends on $rdap_end: renew it at Gandi"
fi

e=$(sed -n 's/^Expires: \([0-9-]*\)T.*/\1/p' /var/www/htdocs/server/.well-known/security.txt)
less_than_30_days_away "$e" && echo "security.txt ends on $e: change Expires in the server repo and run apply"

quad9() { dig +short @9.9.9.9 $d "$1" | sort | tr '\n' ' '; }
[ "$(quad9 NS)" = "ns-126-c.gandi.net. ns-130-a.gandi.net. ns-225-b.gandi.net. " ] || echo "NS is now: $(quad9 NS)"
[ "$(quad9 MX)" = "10 $d. " ] || echo "MX is now: $(quad9 MX)"
selector=$(sed -n 's/.*filter-dkimsign.* -s \([^ ]*\) .*/\1/p' /etc/mail/smtpd.conf)
dkim_key=$(openssl pkey -in /etc/mail/dkim/$d.$selector.rsa.key -pubout -outform DER | openssl base64 -A)
dkim_dns=$(dig +short @9.9.9.9 $selector._domainkey.$d TXT | tr -d '" \n' | sed 's/.*p=//; s/;.*//')
[ "$dkim_dns" = "$dkim_key" ] || echo "the DKIM record $selector._domainkey does not match the key on this server"
[ "$(quad9 A)" = "$ip4 " ] || echo "A is now: $(quad9 A)"
[ -n "$(quad9 AAAA)" ] || echo "AAAA is now empty"
for a in $(quad9 AAAA); do echo "$ip6" | grep -qx "$a" || echo "AAAA is now: $a"; done

spamhaus_zen_answer=$(dig +short @127.0.0.1 "$(echo "$ip4" | awk -F. '{ print $4 "." $3 "." $2 "." $1 }')".zen.spamhaus.org)
case $spamhaus_zen_answer in
"") ;;
127.255.255.*) echo "Spamhaus refused the query: $spamhaus_zen_answer" ;;
*) echo "$ip4 is on Spamhaus ZEN: $spamhaus_zen_answer" ;;
esac

# Ages in minutes: find rounds up, so -mtime +0 would match every file.
# feed-update hides a failing source behind its last good copy, so only the age of that copy shows it.
feed=/var/www/feed
find $feed/feed.xml -mmin +360 | sed 's#.*/##; s/$/ has not been rebuilt for 6 hours/'
find $feed/edmw.xml -mmin +2880 2>/dev/null | sed 's#.*/##; s/$/ has not been rebuilt for 2 days/'
# edmw-update writes its first file about a day after install, and install gives the script a new date.
[ -e $feed/edmw.xml ] || find /usr/local/sbin/edmw-update -mmin +2880 | sed 's/.*/edmw.xml is still missing 2 days after install/'
find $feed/singapore-policy-actionables.txt -mmin +11520 2>/dev/null | sed 's#.*/##; s/$/ has not been rebuilt for 8 days/'
find $feed/sg-cache -type f -mmin +30240 2>/dev/null | sed 's#.*/##; s/^/Singapore source has not loaded for 3 weeks: /'
find $feed/cache -type f -mmin +4320 ! -name 'forecaster-*' 2>/dev/null | sed 's#.*/##; s/^/feed source has not loaded for 3 days: /'
# A quiet forecaster still has a feed that loads, so none loading in a day means hnrss.org is down.
find $feed/cache -type f -name 'forecaster-*' ! -name 'forecaster-lw-*' ! -name 'forecaster-blog-*' -mmin -1440 2>/dev/null | grep -q . || echo "no Hacker News forecaster feed has loaded for a day"

# Only the two newest releases get patches. A release's folder appears when it comes out.
following() { awk -v v="$1" 'BEGIN { printf "%.1f", v + 0.1 }'; }
released() { ftp -MVo /dev/null "https://cdn.openbsd.org/pub/OpenBSD/$1/amd64/SHA256.sig" 2>/dev/null; }
release=$(uname -r)
next_release=$(following "$release")
if released "$(following "$next_release")"; then
	echo "OpenBSD $release no longer gets patches: run sysupgrade"
elif released "$next_release" && [ "$(date +%u)" = 1 ]; then
	echo "OpenBSD $next_release is out: run sysupgrade before the release after it ends patches for $release"
fi

ct_last_id_file=/var/db/ct-last-id
key=$(openssl pkey -in /etc/ssl/private/$d.key -pubout -outform DER | sha256)
last=$(cat $ct_last_id_file 2>/dev/null)
ftp -MVo - "https://api.certspotter.com/v1/issuances?domain=$d&include_subdomains=true${last:+&after=$last}" |
	tr -d ' \t"[]{}\n' | tr ',' '\n' | awk -F: -v key="$key" -v s="$ct_last_id_file" -v new="${last:+yes}" '
	$1 == "id" { id = $2 }
	$1 == "cert_sha256" { cert = $2 }
	$1 == "pubkey_sha256" && $2 != key && new { print "certificate not made by this server: https://crt.sh/?q=" cert }
	END { if (id) print id > s }'

# Every line of this check travels by mail, so a server whose mail cannot leave looks like one with
# nothing to report. The outside checks read this file: when the check last finished, and whether mail is leaving.
echo "$(date +%s) stuck=$stuck lost=$lost" > /var/www/status/health.txt
