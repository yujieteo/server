my %months;
@months{qw(Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec)} = (0 .. 11);

sub plain {
	my ($text) = @_;
	my $wrapped = $text =~ s/<!\[CDATA\[(.*?)\]\]>/$1/gs;
	$text =~ s/<\/?(?:p|br|pre)\b[^>]*>/ /gi if $wrapped;
	$text =~ s/<[^>]*>//g if $wrapped;
	$text = unescaped($text);
	$text =~ s/<[^>]*>//g unless $wrapped;
	$text =~ s/[\x00-\x08\x0b\x0c\x0e-\x1f]//g;
	$text =~ s/\s+/ /g;
	$text =~ s/^ | $//g;
	return $text;
}

sub link_of {
	my ($block) = @_;
	my $text = plain(field($block, 'link'));
	return $text if $text =~ /^https?:/;
	while ($block =~ /(<link\b[^>]*>)/g) {
		my $tag = $1;
		my ($href) = $tag =~ /href="([^"]+)"/;
		my ($rel) = $tag =~ /rel="([^"]+)"/;
		return plain($href) if defined $href && $href =~ /^https?:/ && ($rel // 'alternate') eq 'alternate';
	}
	return '';
}

sub offset {
	my ($zone) = @_;
	return 0 unless defined $zone && $zone =~ /^([+-])(\d\d):?(\d\d)$/;
	return ($1 eq '-' ? -1 : 1) * ($2 * 3600 + $3 * 60);
}

sub epoch {
	my ($text) = @_;
	my ($day, $month, $year, $hour, $minute, $second, $zone);
	if ($text =~ /^(\d{4})-(\d\d)-(\d\d)T(\d\d):(\d\d):(\d\d)(?:\.\d+)?(Z|[+-]\d\d:?\d\d)?/) {
		($year, $month, $day, $hour, $minute, $second, $zone) = ($1, $2 - 1, $3, $4, $5, $6, $7);
	} elsif ($text =~ /(\d{1,2}) ([A-Z][a-z]{2}) (\d{4}) (\d\d):(\d\d)(?::(\d\d))?\s*([+-]\d{4})?/) {
		return undef unless defined $months{$2};
		($day, $month, $year, $hour, $minute, $second, $zone) = ($1, $months{$2}, $3, $4, $5, $6 // 0, $7);
	} else {
		return undef;
	}
	my $time = eval { timegm($second, $minute, $hour, $day, $month, $year) };
	return defined $time ? $time - offset($zone) : undef;
}

# An arXiv paper keeps its identity across revisions: the abstract address with no version number.
# The arXiv API links to the newest revision (/abs/2102.13459v4), so the version is left out.
# A modern id is 2102.13459. An old one has its archive first, as in math/0601001 or math.AG/0601001.
# Any other link gives nothing, so its item keeps the id and RSS GUID it always had.
my $arxiv_id = qr{(?:\d{4}\.\d{4,5}|[a-z]+(?:-[a-z]+)?(?:\.[A-Za-z]+(?:-[a-z]+)?)?/\d{7})};

sub arxiv_identity {
	my ($link) = @_;
	return $link =~ m{^https?://(?:www\.|export\.)?arxiv\.org/abs/($arxiv_id)(?:v\d+)?$} ? "https://arxiv.org/abs/$1" : undef;
}

# Before arXiv items had a stable id, an item's id was the hash of the link with its version.
# Notes saved then are under those ids, so these are the ids of every version up to this one, newest first.
sub legacy_ids {
	my ($link) = @_;
	return () unless defined arxiv_identity($link);
	my ($base, $version) = $link =~ m{^(.*?)(?:v(\d+))?$};
	my @links = ($link);
	push @links, map { "${base}v$_" } reverse 1 .. ($version < 100 ? $version - 1 : 99) if defined $version;
	return map { substr(md5_hex($_), 0, 8) } @links;
}

sub parse {
	my ($xml, $name, $limit) = @_;
	my @items;
	while ($xml =~ /<(item|entry)[\s>](.*?)<\/\1>/gs) {
		my $block = $2;
		my $title = headline(plain(field($block, 'title')));
		my $link = link_of($block);
		my $date = epoch(plain(field($block, qw(pubDate published updated dc:date))));
		my ($source, $text) = ($name, '');
		my $description = field($block, qw(description content:encoded content summary));
		(my $body = plain($description)) =~ s/\s*Discuss$//;
		if ($title =~ /^New comment by (.+?) in "(.*)"$/) {
			($source, $title) = ("$1 on $name", $2);
			$text = excerpt($body, $excerpt_length);
		} elsif ($link =~ m{^https://www\.lesswrong\.com/.*[?&]commentId=} && $title =~ /^Comment on (.+)$/) {
			$title = $1;
			$text = excerpt($body, $excerpt_length);
		}
		next unless $title ne '' && $link =~ m{^https?://\S{1,2000}$} && defined $date;
		my $identity = arxiv_identity($link);
		push @items, { id => substr(md5_hex($identity // $link), 0, 8), title => $title, link => $link, date => $date, source => $source, label => $text eq '' ? $source : "$source: $text",
			body => $body, market => $description =~ m{(?:manifold\.markets|polymarket\.com|kalshi\.com)/} ? 1 : 0 };
		$items[-1]{guid} = $identity if defined $identity;
		last if @items == $limit;
	}
	return @items;
}

sub render {
	my ($now, $feed, @items) = @_;
	my $format = '%a, %d %b %Y %H:%M:%S GMT';
	my $built = strftime($format, gmtime $now);
	my $body = '';
	for my $item (@items) {
		my $link = escaped($item->{link});
		my $title = escaped($item->{title});
		my $label = escaped($item->{label});
		my $date = strftime($format, gmtime $item->{date});
		my $guid = defined $item->{guid} ? '<guid isPermaLink="false">' . escaped($item->{guid}) : qq{<guid isPermaLink="true">$link};
		$body .= qq{<item><title>$title</title><link>$link</link>$guid</guid><pubDate>$date</pubDate><description>$label</description></item>\n};
	}
	my $description = escaped($feed->{about});
	return <<"EOF";
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel>
<title>Yu Jie Teo: $feed->{id} feed</title>
<link>$site/$feed->{id}.html</link>
<description>$description</description>
<atom:link href="$site/$feed->{xml}" rel="self" type="application/rss+xml"/>
<lastBuildDate>$built</lastBuildDate>
$body</channel></rss>
EOF
}

sub render_page {
	my ($now, $page, @items) = @_;
	my $built = strftime('%d %b %Y, %H:%M UTC', gmtime $now);
	my $list = '';
	for my $item (@items) {
		my $link = escaped($item->{link});
		my $title = escaped($item->{title});
		my $label = escaped($item->{label});
		my $date = strftime('%Y-%m-%d', gmtime $item->{date});
		$list .= qq{<li><a href="$link" rel="noopener noreferrer"><h3>$title</h3><span class="kind">$date</span><p>$label</p></a></li>\n};
	}
	my $description = escaped($page->{about});
	return <<"EOF";
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="only light">
<link rel="icon" href="data:,">
<link rel="stylesheet" href="/style.css">
$page->{head}<title>$page->{title}</title>
<meta name="description" content="$description">
</head>
<body>
<header class="wrap"><a class="name" href="/">Yu Jie Teo</a></header>
<main class="wrap"><section id="$page->{id}"><h2>$page->{title}</h2>
<p class="muted">Updated $built. $page->{note}</p>
<ol class="featured">
$list</ol></section></main>
</body>
</html>
EOF
}

# The file an AI model reads to write notes. Short fields keep it cheap to read.
sub render_text {
	my ($now, $about, $how, @items) = @_;
	my $built = strftime('%Y-%m-%d %H:%M UTC', gmtime $now);
	my $text = "# $about Built $built.\n# Columns, split by tabs: id, date, source, title, link.\n# $how The format is at $site/api/notes.txt\n";
	for my $item (@items) {
		$text .= join("\t", $item->{id}, strftime('%Y-%m-%d', gmtime $item->{date}), $item->{source}, $item->{title}, $item->{link}) . "\n";
	}
	return $text;
}

sub fetch {
	my ($url) = @_;
	return $url =~ m{^/} ? slurp($url) : fetch_url($url, 20);
}

my $cache = "$folder/cache";
my $notes_text = slurp($notes_file);
my $bets_text = slurp($bets_file);
confine($folder);
mkdir $cache unless -d $cache;

# Every fetch comes first. With the texts in memory the job gives up ftp, and only then parses them.
# hnrss and LessWrong get a pause between requests.
for my $group ([0, \@sources], [$forecasters_pause, \@forecaster_sources], [$lesswrong_pause, \@lesswrong_sources]) {
	my ($pause, $list) = @$group;
	for my $source (@$list) {
		sleep $pause if $pause;
		$source->[4] = fetch($source->[1]);
	}
}
fetched();

my $now = time;
my $clock_slack = 86400;
my %saved_names;

# A source that fails falls back to its last good copy, saved under its cache key.
sub gather {
	my (@list) = @_;
	my $working = 0;
	my %seen;
	for my $source (@list) {
		my ($name, $url, $limit, $key, $xml) = @$source;
		my @items = parse($xml, $name, $limit);
		(my $saved_name = $key // $name) =~ s/[^\w.-]+/-/g;
		my $saved = "$cache/$saved_name";
		$saved_names{$saved_name} = 1;
		if (@items) {
			$working++;
			publish($saved, $xml);
		} else {
			@items = parse(fetch($saved), $name, $limit);
		}
		for my $item (@items) {
			# A feed's clock can run ahead: Stallman's dates are five hours early. Such an item is new now.
			# A date over a day ahead is a mistake, so that item is left out.
			next if $item->{date} > $now + $clock_slack;
			$item->{date} = $now if $item->{date} > $now;
			# An arXiv paper is one item, whatever revision a link names.
			$seen{$item->{guid} // $item->{link}} //= $item;
		}
	}
	return ($working, \%seen);
}

my ($working, $seen) = gather(@sources);
die "feed-update: only $working of " . scalar(@sources) . " sources worked, the old feed stays\n" if $working * 2 < @sources;

# A note moves an item by one hour for each point, and its text goes first in the label.
# A note under the item's id comes first. An arXiv item also finds a note saved under an older id.
my $notes = read_notes($notes_text);
for my $item (values %$seen) {
	my ($note) = grep { defined } map { $notes->{$_} } $item->{id}, legacy_ids($item->{link});
	next unless $note;
	$item->{rank} = $note->{points} * 3600;
	$item->{label} = "$note->{text} · $item->{label}" if $note->{text} ne '';
}
my @sorted = sort { $b->{date} + ($b->{rank} // 0) <=> $a->{date} + ($a->{rank} // 0) || $a->{id} cmp $b->{id} } values %$seen;
splice @sorted, $max_items if @sorted > $max_items;
my %reading = (
	title => 'Reading',
	id => 'reading',
	xml => 'feed.xml',
	about => $about,
	head => qq{<link rel="alternate" type="application/rss+xml" title="Reading feed" href="/feed.xml">\n},
	note => 'Newest first, moved by <a href="/api/notes.txt">notes from an AI model</a>. <a href="/feed.xml">RSS feed</a>. <a href="/reading.txt">Plain text</a>',
);
publish("$folder/reading.html", render_page($now, \%reading, @sorted));
publish($out, render($now, \%reading, @sorted));
publish("$folder/reading.txt", render_text($now, 'The reading feed, newest first after notes.', 'To move an item or add a sentence to it, add a line to notes/reading.tsv in github.com/yujieteo/site.', @sorted));

# Last, so a failing forecaster feed cannot stop the reading feed.
my ($forecasters_working, $forecasters_seen) = gather(@forecaster_sources);
# A LessWrong writer with no posts has an empty feed, so a low count here is no reason to stop.
my ($lesswrong_working, $lesswrong_seen) = gather(@lesswrong_sources);
# One host serves most of the Hacker News feeds. When it is down, their last good copies fill in and health-check reports it.
die "feed-update: no forecaster feed worked, the old page stays\n" unless $forecasters_working + $lesswrong_working;
warn "feed-update: no LessWrong feed worked\n" unless $lesswrong_working;
$forecasters_seen->{$_} //= $lesswrong_seen->{$_} for keys %$lesswrong_seen;

# The page keeps only bets: checkable claims in the ledger, each with a market price, a source and a due date.
# The site build checks and scores the ledger. Here every cell is still treated as text from outside.
sub read_bets {
	my ($text) = @_;
	my @lines = split /\n/, $text;
	my @columns = split /\t/, shift(@lines) // '';
	return () unless @columns && $columns[0] eq 'id';
	my @bets;
	for my $line (@lines) {
		my %bet;
		@bet{@columns} = map { valid($_) } split /\t/, $line, -1;
		next unless ($bet{id} // '') =~ /^[0-9a-f]{8}$/ && ($bet{made} // '') =~ /^\d{4}-\d\d-\d\dT\d\d:\d\d/;
		next unless grep { ($bet{$_} // '') =~ m{^https://\S+$} } qw(url archive market source);
		$bet{$_} = '' for grep { ($bet{$_} // '') ne '' && $bet{$_} !~ m{^https://\S+$} } qw(url archive market source evidence fermi_url);
		push @bets, \%bet;
	}
	my %by_id = map { $_->{id} => $_ } @bets;
	for my $bet (@bets) {
		my $id = $bet->{repeat_of} // '';
		my $first = $id =~ /\A[0-9a-f]{8}\z/ ? $by_id{$id} : undef;
		delete $bet->{repeat_of} unless $first && $id ne $bet->{id}
			&& ($bet->{by} // '') ne '' && ($first->{by} // '') eq $bet->{by}
			&& ($bet->{market} // '') ne '' && ($first->{market} // '') eq $bet->{market};
	}
	return @bets;
}
my @bets = read_bets($bets_text);
die "feed-update: no bet ledger at $bets_file, the old page stays\n" unless $bets_text =~ /^id\t/;

# Hourly, for a bet whose item is still in its feed: is the quote still in the text? Spaces are ignored,
# because a feed and an API lay out the same text differently.
my %live = map { $_->{link} => $_ } values %$forecasters_seen;
for my $bet (@bets) {
	my $item = $live{$bet->{url}} or next;
	(my $quote = $bet->{quote}) =~ s/\s+//g;
	(my $body = $item->{body}) =~ s/\s+//g;
	$bet->{live} = index($body, $quote) >= 0 ? 'present' : 'missing';
}

# New items that may make or revise a claim, for an agent to record or pass over: a stated chance, a
# commitment to a forecast or a bet (the candidate rule of the audit), or a link to a market.
my $apos = qr/(?:'|\xe2\x80\x99)/;
my $claim_rule = qr/\bI\s+(?:confidently\s+)?(?:predict|forecast)\b
	|\bmy\s+(?:prediction|forecast|bet)\s+(?:is|would\s+be)\b
	|\bI(?:${apos}d|\s+would|${apos}ll|\s+will)\s+(?:happily\s+|gladly\s+)?(?:bet|wager|put\s+money)\b
	|\bI(?:${apos}m|\s+am)\s+(?:betting|predicting|calling\s+it)\b
	|\b(?:willing|happy)\s+to\s+bet\b|\bmark\s+my\s+words\b|\bcalling\s+it\s+now\b
	|\b\d{1,3}(?:\.\d+)?\s?%\s+(?:chance|probability|likely|likelihood|odds|confiden\w*|sure|certain)\b
	|\b(?:chance|probability|likelihood|odds|credence|confiden\w*)\s+(?:of\s+|is\s+|at\s+|that\s+[^.?!]{0,60}?)?(?:about\s+|around\s+|roughly\s+|maybe\s+)?\d{1,3}(?:\.\d+)?\s?%
	|\b\d{1,3}\s?(?:to|:)\s?\d{1,3}\s+odds\b|\bodds\s+(?:of|are|at)\s+\d{1,3}\s?(?:to|:)\s?\d{1,3}\b/xi;
my %recorded = map { $_->{url} => 1 } @bets;
my @candidates;
for my $item (sort { $b->{date} <=> $a->{date} || $a->{id} cmp $b->{id} } values %$forecasters_seen) {
	next if $recorded{$item->{link}};
	my $match = '';
	if ($item->{body} =~ $claim_rule) {
		my $at = $-[0] > 150 ? $-[0] - 150 : 0;
		$match = substr($item->{body}, $at, 400);
		$match =~ s/^[\x80-\xbf]+//;
		$match = excerpt($match, 300);
	} elsif ($item->{market}) {
		$match = 'links a market';
	}
	push @candidates, { %$item, match => $match } if $match ne '';
}

sub percent {
	my ($x) = @_;
	return $x < 0.01 || $x > 0.99 ? sprintf('%.1f%%', 100 * $x) : sprintf('%.0f%%', 100 * $x);
}

sub stamp {
	my ($iso) = @_;
	return $iso =~ /^(\d{4}-\d\d-\d\d)T(\d\d:\d\d)/ ? "$1 $2 UTC" : escaped($iso);
}

sub anchor {
	my ($url, $text) = @_;
	return escaped($text) if ($url // '') eq '';
	return '<a href="' . escaped($url) . '" rel="noopener noreferrer">' . escaped($text) . '</a>';
}

# Settlements and scored forecasts are separate: a repeated bet is still kept in the ledger.
my @people = (@forecasters, map { $_->[0] } @lesswrong);
my %person = map { $_ => { bets => 0, settled => 0, scored => 0, score => 1 } } @people;
for my $bet (@bets) {
	my $p = $person{$bet->{by}} or next;
	$p->{bets}++;
	$p->{settled}++ if $bet->{outcome} ne 'open';
	$p->{scored}++ if $bet->{factor} ne '' && $bet->{outcome} ne 'void' && !$bet->{repeat_of};
	$p->{score} = $bet->{running_e} if $bet->{running_e} =~ /^\d+(?:\.\d+)?(?:e[+-]?\d+)?$/;
}

sub render_bets {
	my ($now, @list) = @_;
	my $built = strftime('%d %b %Y, %H:%M UTC', gmtime $now);
	my $today = strftime('%Y-%m-%d', gmtime $now);
	my $rows = '';
	for my $name (sort { $person{$b}{bets} <=> $person{$a}{bets} || lc $a cmp lc $b } grep { $person{$_}{bets} } @people) {
		my $p = $person{$name};
		my $score = $p->{scored} ? sprintf('%.3g', $p->{score}) : '';
		$rows .= '<tr><td>' . escaped($name) . "</td><td>$p->{bets}</td><td>$p->{settled}</td><td>$p->{scored}</td><td>$score</td></tr>\n";
	}
	my @none = sort { lc $a cmp lc $b } grep { !$person{$_}{bets} } @people;
	my $none = @none ? '<p>No priced bet yet: ' . join(', ', map { escaped($_) } @none) . '.</p>' : '';
	my $cards = '';
	for my $bet (reverse @list) {
		my $id = $bet->{id};
		my ($snapshot) = $bet->{archive} =~ m{/web/(\d{4})(\d\d)(\d\d)};
		$snapshot = $snapshot ? join('-', $bet->{archive} =~ m{/web/(\d{4})(\d\d)(\d\d)}) : '';
		my $view = $bet->{p} ne '' ? 'Stated chance of YES: ' . percent($bet->{p}) : 'Takes the ' . uc($bet->{side}) . ' side, with no stated chance';
		my $edited = $bet->{edited} ne '' ? " The site reports an edit on $bet->{edited}." : '';
		my $live = !defined $bet->{live} ? '' : $bet->{live} eq 'present' ? " Still in its feed at $built, and the quote is still there." : " Still in its feed at $built, but the quote is no longer in the text.";
		my $verdict;
		if ($bet->{outcome} eq 'open') {
			$verdict = $bet->{due} lt $today ? "Open: the due date has passed and the source has not resolved." : 'Open.';
		} elsif ($bet->{outcome} eq 'void') {
			$verdict = 'Void: the source cancelled or only partly resolved it (' . anchor($bet->{evidence}, $bet->{settled}) . ').';
		} else {
			$verdict = 'Resolved ' . uc($bet->{outcome}) . ' on ' . anchor($bet->{evidence}, $bet->{settled}) . '.';
			$verdict .= ' Factor against the market: ' . sprintf('%.3g', $bet->{factor}) . '. Running score of ' . escaped($bet->{by}) . ': ' . sprintf('%.3g', $bet->{running_e}) . '.' unless $bet->{repeat_of};
		}
		if (my $first = $bet->{repeat_of}) {
			$verdict .= qq{ Not scored separately: uses the same recorded market as <a href="#bet-$first">bet $first</a>.};
		}
		my $revises = $bet->{revises} =~ /^[0-9a-f]{8}$/ ? qq{ Revises <a href="#bet-$bet->{revises}">bet $bet->{revises}</a>.} : '';
		my $correction = $bet->{correction} ne '' ? '<p>Correction: ' . escaped($bet->{correction}) . '</p>' : '';
		my $by = escaped($bet->{by});
		$cards .= qq{<li id="bet-$id"><h3>} . escaped($bet->{claim}) . qq{</h3>\n}
			. '<p class="quote">“' . escaped($bet->{quote}) . "” — $by, " . anchor($bet->{url}, stamp($bet->{made})) . "</p>\n"
			. "<p>$view. Market price that day: " . anchor($bet->{market}, percent($bet->{price})) . ' at ' . stamp($bet->{price_at}) . ".</p>\n"
			. '<p>Fermi check: ' . anchor($bet->{fermi_url}, $bet->{fermi}) . "</p>\n"
			. '<p>Settled only by ' . anchor($bet->{source}, 'the market\'s own resolution') . ", due $bet->{due}. $verdict$revises</p>\n$correction"
			. '<p>Text: ' . anchor($bet->{archive}, "archive.org snapshot $snapshot") . ", SHA-256 <code>" . substr($bet->{sha256}, 0, 16) . "…</code>.$edited$live"
			. qq{ <a href="mailto:$contact?subject=Dispute%20of%20bet%20$id">Dispute this</a></p></li>\n};
	}
	$cards = '<p class="muted">No bets are recorded yet.</p>' if $cards eq '';
	my $description = escaped($forecasters_about);
	my $count = @list;
	return <<"EOF";
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="only light">
<link rel="icon" href="data:,">
<link rel="stylesheet" href="/style.css">
<link rel="alternate" type="application/rss+xml" title="Forecasters feed" href="/forecasters.xml">
<title>Forecasters</title>
<meta name="description" content="$description">
</head>
<body>
<header class="wrap"><a class="name" href="/">Yu Jie Teo</a></header>
<main class="wrap page"><article id="forecasters"><h1>Forecasters</h1>
<p class="meta muted">Updated $built. $count bets. <a href="/forecasters.xml">RSS feed</a>. <a href="/forecasters.txt">New items to check</a>. <a href="/api/bets.txt">Scored bets as text</a>. <a href="$ledger">The ledger</a></p>
<p>These are the 20 Hacker News commenters and 20 LessWrong writers of the <a href="/essays/hn-forecasters/">Hacker News</a> and <a href="/essays/lw-forecasters/">LessWrong</a> rankings. <a href="$audit">A pre-registered test</a> found that chance explains the top ranks of both rankings. So this page judges them only by what they forecast and what happened, in time order, and keeps only checkable claims that a market priced on the day they were made.</p>
<h2>How a bet is scored</h2>
<ul>
<li>A bet is a claim that one of the 40 made or revised, in their own words, on a question a market resolves. The quote, the posting time, an archive.org snapshot and a SHA-256 of the text are stored when it is recorded.</li>
<li>The price is the market's YES price just before the item was posted. A stated chance p is scored against it: the factor is p/price if YES, and (1 − p)/(1 − price) if NO. With no stated chance, the bet stakes half at the market price on the side the person takes.</li>
<li>Only the named source settles a bet: the market's own resolution. A cancelled or partial resolution is void and does not change the score.</li>
<li>Where marked, later bets by the same person on the same recorded market stay visible but do not add another score factor. Older ledger exports may not identify repeats.</li>
<li>A person's running score multiplies the recorded factors. It describes the recorded bets; it does not establish statistical significance.</li>
<li>The Fermi check compares any physical quantity a claim implies with the most ever built or made in a year, from EIA, IAEA and SEC EDGAR filings.</li>
<li>Names are as the people give them. If you are named and a quote, price or verdict is wrong, use the dispute link of the bet. Corrections are made in the ledger and shown on the bet.</li>
</ul>
<h2>People</h2>
<table><thead><tr><th>Person</th><th>Bets</th><th>Settled</th><th>Scored</th><th>Running score against the market</th></tr></thead><tbody>
$rows</tbody></table>
$none
<h2>Bets, newest first</h2>
<ol class="bets">
$cards</ol></article></main>
</body>
</html>
EOF
}

# The feed carries a bet when it is made and again when it is settled.
my @feed_items;
for my $bet (@bets) {
	my $made = epoch($bet->{made}) // next;
	my $title = "$bet->{by}: $bet->{claim}";
	my $view = $bet->{p} ne '' ? 'stated ' . percent($bet->{p}) : "takes $bet->{side}";
	my $link = "$site/forecasters.html#bet-$bet->{id}";
	push @feed_items, { link => $link, guid => "bet-$bet->{id}", title => $title, date => $made, label => "“$bet->{quote}” Market " . percent($bet->{price}) . ", $view. Due $bet->{due}." };
	my $repeat = $bet->{repeat_of} ? "Not scored separately: uses the same recorded market as bet $bet->{repeat_of}." : '';
	$feed_items[-1]{label} .= " $repeat" if $repeat ne '';
	if ($bet->{outcome} ne 'open' && $bet->{settled} =~ /^\d{4}-\d\d-\d\d$/) {
		my $label = $bet->{outcome} eq 'void' ? 'Void: no change to the running score.' . ($repeat ne '' ? " $repeat" : '')
			: $repeat ne '' ? $repeat
			: "Factor against the market: $bet->{factor}. Running score of $bet->{by}: $bet->{running_e}.";
		push @feed_items, { link => $link, guid => "bet-$bet->{id}-$bet->{outcome}", title => "Settled $bet->{outcome}: $title", date => epoch("$bet->{settled}T00:00:00Z"), label => $label };
	}
}
@feed_items = sort { $b->{date} <=> $a->{date} || $a->{guid} cmp $b->{guid} } @feed_items;
splice @feed_items, $forecasters_max_items if @feed_items > $forecasters_max_items;

my %forecasters = (title => 'Forecasters', id => 'forecasters', xml => 'forecasters.xml', about => $forecasters_about);
publish("$folder/forecasters.html", render_bets($now, @bets));
publish("$folder/forecasters.xml", render($now, \%forecasters, @feed_items));
my $queue = strftime('%Y-%m-%d %H:%M UTC', gmtime $now);
my $text = "# New items by the 40 ranked forecasters that may make or revise a checkable claim and are not in the bet ledger yet. Built $queue.\n"
	. "# Columns, split by tabs: id, date, source, title, link, match. To record a bet, give scripts/bets/bets.py a proposal in github.com/yujieteo/site.\n";
for my $item (@candidates) {
	$text .= join("\t", $item->{id}, strftime('%Y-%m-%d', gmtime $item->{date}), map { my $x = $_; $x =~ s/[\t\n]/ /g; $x } $item->{source}, $item->{title}, $item->{link}, $item->{match}) . "\n";
}
publish("$folder/forecasters.txt", $text);

# The manifest lets an agent ask once whether any text file changed. It lists what is in the folder now:
# sg-update writes the policy file weekly, so that entry can be older than the others.
my @manifest;
for my $name (qw(reading.txt forecasters.txt singapore-policy-actionables.txt)) {
	my $content = slurp("$folder/$name");
	next if $content eq '';
	push @manifest, sprintf('{"path": "/%s", "bytes": %d, "sha256": "%s"}', $name, length $content, sha256_hex($content));
}
publish("$folder/feeds-manifest.json", sprintf(qq{{"built_at": "%s", "files": [%s]}\n}, strftime('%Y-%m-%dT%H:%M:%SZ', gmtime $now), join(', ', @manifest)));
prune($cache, %saved_names);
