#!/usr/bin/perl
use strict;
use warnings;
use POSIX qw(strftime);
use Time::Local qw(timegm);
use Digest::MD5 qw(md5_hex);
use FindBin;
require "$FindBin::Bin/feed-common.pl";

my $out = $ARGV[0] // '/var/www/web/feed/feed.xml';
my $notes_file = $ARGV[1] // '/var/www/web/site/notes/reading.txt';
my $site = 'https://teoyujie.org';
my $max_items = 70;
my $excerpt_length = 600;
my $about = "Mathematics, Stallman's political notes and the best Hacker News and EDMW comments, gathered from public feeds.";
(my $edmw = $out) =~ s{[^/]*$}{edmw.xml};

my $categories = join '+OR+', map { "cat:$_" } qw(math.NT math.AG math.AT math.KT math.RT hep-th);
my $titles = join '+OR+', map { "ti:$_" } qw(Langlands motivic motives homotopy K-theory cohomology anomaly Chern-Simons %22class+field%22);
my $arxiv = "https://export.arxiv.org/api/query?search_query=%28$categories%29+AND+%28$titles%29&sortBy=submittedDate&sortOrder=descending&max_results=15";

my @sources = (
	["Stallman's political notes", 'https://stallman.org/rss/rss.xml', 15],
	['arXiv', $arxiv, 15],
	['Terence Tao', 'https://terrytao.wordpress.com/feed/', 5],
	['Not Even Wrong', 'https://www.math.columbia.edu/~woit/wordpress/?feed=rss2', 5],
	['Hacker News', 'https://hnrss.org/bestcomments?count=30', 30],
	['EDMW', $edmw, 15],
);

my $forecasters_about = 'The latest comments and posts from the 20 Hacker News commenters and the 20 LessWrong writers with the best forecasting records.';
my $forecasters_max_items = 90;
my $forecasters_per_feed = 6;
# hnrss starts refusing after about ten quick requests.
my $forecasters_pause = 5;
my @forecasters = qw(
	stcredzero wmf gojomo adventured jonnathanson earl Zigurd gbog nostrademons potatolicious
	dasil003 snowwrestler nl jsjenkins168 Samuel_Michon bane bryanlarsen SwellJoe tptacek btilly
);
my @forecaster_sources = map { ['Hacker News', "https://hnrss.org/threads?id=$_", $forecasters_per_feed, "forecaster-$_"] } @forecasters;
push @forecaster_sources,
	["gojomo's blog", 'https://memesteading.wordpress.com/feed/', $forecasters_per_feed, 'forecaster-blog-gojomo'],
	["bryanlarsen's blog", 'https://bryan.larsen.st/feed.xml', $forecasters_per_feed, 'forecaster-blog-bryanlarsen'],
	["SwellJoe's blog", 'https://swelljoe.com/index.xml', $forecasters_per_feed, 'forecaster-blog-SwellJoe'];

# LessWrong serves a feed of comments and a feed of posts for each user id.
my $lesswrong_pause = 2;
my @lesswrong = (
	['Zvi', 'N9zj5qpTfqmbn9dro'], ['gwern', 'BtbwfsEyeT4P2eqXu'], ['Daniel Kokotajlo', 'YLFQfGzNdGA4NFcKS'],
	['Matthew Barnett', 'TWDkQT6f9mgyNXQ4p'], ['Rohin Shah', 'du6SPHKnnPrPmxWNT'], ['Richard_Kennaway', 'tumpuMka2DnK7zW73'],
	['paulfchristiano', 'gb44edJjXhte8DA3A'], ['knb', 'YEwEAL5Mu6YxaX4rD'], ['Costanza', 'cXudnoTp54SYgqfgF'],
	['jsteinhardt', 'EF8W65G6RaXxZjLBX'], ['Mati_Roy', 'Tw9etd8rMnHLeSQ9q'], ['orthonormal', '4fh2AAe3n7oBviyxx'],
	['Cthulhoo', '9Bn8KsjZrr5DmFNHW'], ['mfb', 'Ze9tyaDB9MZDh9XKZ'], ['JoshuaZ', 'fmTiLqp6mmXeLjwfN'],
	['Liam Donovan', 'HeRKphdWzJhkfWuJh'], ['Dagon', '3EiFeonpTS34c3vzZ'], ['Kevin', '8GnKujYLZ2ZZLs5zk'],
	['TheRev', 'Qf7dawgKSDMJ3BjkN'], ['AspiringKnitter', 'wyuRmEzfzp3zGgSNK'],
);
my @lesswrong_sources = map {
	my ($name, $id) = @$_;
	(["$name on LessWrong", "https://www.lesswrong.com/feed.xml?type=comments&userId=$id", $forecasters_per_feed, "forecaster-lw-comments-$id"],
	 ["$name on LessWrong", "https://www.lesswrong.com/feed.xml?userId=$id", $forecasters_per_feed, "forecaster-lw-posts-$id"]);
} @lesswrong;
# Zvi posts the same articles to his blog, so his LessWrong post feed would show each one twice.
@lesswrong_sources = grep { $_->[3] ne 'forecaster-lw-posts-N9zj5qpTfqmbn9dro' } @lesswrong_sources;
# Blogs these writers name as their own, and the one Hacker News account that names the same site as its LessWrong owner.
push @lesswrong_sources,
	["Zvi's blog", 'https://thezvi.wordpress.com/feed/', $forecasters_per_feed, 'forecaster-blog-zvi'],
	["Matthew Barnett's blog", 'https://matthewbarnett.substack.com/feed', $forecasters_per_feed, 'forecaster-blog-matthew-barnett'],
	['AI Futures Project blog', 'https://blog.aifutures.org/feed', $forecasters_per_feed, 'forecaster-blog-aifutures'],
	["jsteinhardt's blog", 'https://bounded-regret.ghost.io/rss/', $forecasters_per_feed, 'forecaster-blog-jsteinhardt'],
	["gwern's newsletter", 'https://gwern.substack.com/feed', $forecasters_per_feed, 'forecaster-blog-gwern'],
	["Rohin Shah's blog", 'https://rohinshah.com/feed/', $forecasters_per_feed, 'forecaster-blog-rohinmshah'],
	['Hacker News', 'https://hnrss.org/threads?id=gwern', $forecasters_per_feed, 'forecaster-gwern'];

my %months;
@months{qw(Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec)} = (0 .. 11);

sub plain {
	my ($text) = @_;
	my $wrapped = $text =~ s/<!\[CDATA\[(.*?)\]\]>/$1/gs;
	$text =~ s/<\/?(?:p|br|pre)\b[^>]*>/ /gi if $wrapped;
	$text =~ s/<[^>]*>//g if $wrapped;
	$text = unescaped($text);
	$text =~ s/<[^>]*>//g unless $wrapped;
	$text =~ s/[\x00-\x08\x0b\x0c\x0e-\x1f]//g;
	$text =~ s/\s+/ /g;
	$text =~ s/^ | $//g;
	return $text;
}

sub field {
	my ($block, @tags) = @_;
	for my $tag (@tags) {
		return $1 if $block =~ m{<\Q$tag\E(?:\s[^>]*)?>(.*?)</\Q$tag\E>}s;
	}
	return '';
}

sub link_of {
	my ($block) = @_;
	my $text = plain(field($block, 'link'));
	return $text if $text =~ /^https?:/;
	while ($block =~ /(<link\b[^>]*>)/g) {
		my $tag = $1;
		my ($href) = $tag =~ /href="([^"]+)"/;
		my ($rel) = $tag =~ /rel="([^"]+)"/;
		return plain($href) if defined $href && $href =~ /^https?:/ && ($rel // 'alternate') eq 'alternate';
	}
	return '';
}

sub offset {
	my ($zone) = @_;
	return 0 unless defined $zone && $zone =~ /^([+-])(\d\d):?(\d\d)$/;
	return ($1 eq '-' ? -1 : 1) * ($2 * 3600 + $3 * 60);
}

sub epoch {
	my ($text) = @_;
	my ($day, $month, $year, $hour, $minute, $second, $zone);
	if ($text =~ /^(\d{4})-(\d\d)-(\d\d)T(\d\d):(\d\d):(\d\d)(?:\.\d+)?(Z|[+-]\d\d:?\d\d)?/) {
		($year, $month, $day, $hour, $minute, $second, $zone) = ($1, $2 - 1, $3, $4, $5, $6, $7);
	} elsif ($text =~ /(\d{1,2}) ([A-Z][a-z]{2}) (\d{4}) (\d\d):(\d\d)(?::(\d\d))?\s*([+-]\d{4})?/) {
		return undef unless defined $months{$2};
		($day, $month, $year, $hour, $minute, $second, $zone) = ($1, $months{$2}, $3, $4, $5, $6 // 0, $7);
	} else {
		return undef;
	}
	my $time = eval { timegm($second, $minute, $hour, $day, $month, $year) };
	return defined $time ? $time - offset($zone) : undef;
}

sub parse {
	my ($xml, $name, $limit) = @_;
	my @items;
	while ($xml =~ /<(item|entry)[\s>](.*?)<\/\1>/gs) {
		my $block = $2;
		my $title = plain(field($block, 'title'));
		my $link = link_of($block);
		my $date = epoch(plain(field($block, qw(pubDate published updated dc:date))));
		my ($source, $text) = ($name, '');
		if ($title =~ /^New comment by (.+?) in "(.*)"$/) {
			($source, $title) = ("$1 on $name", $2);
			$text = excerpt(plain(field($block, 'description')), $excerpt_length);
		} elsif ($link =~ m{^https://www\.lesswrong\.com/.*[?&]commentId=} && $title =~ /^Comment on (.+)$/) {
			$title = $1;
			(my $body = plain(field($block, 'description'))) =~ s/\s*Discuss$//;
			$text = excerpt($body, $excerpt_length);
		}
		next unless $title ne '' && $link =~ m{^https?://} && defined $date;
		push @items, { id => substr(md5_hex($link), 0, 8), title => $title, link => $link, date => $date, source => $source, label => $text eq '' ? $source : "$source: $text" };
		last if @items == $limit;
	}
	return @items;
}

sub render {
	my ($now, $feed, @items) = @_;
	my $format = '%a, %d %b %Y %H:%M:%S GMT';
	my $built = strftime($format, gmtime $now);
	my $body = '';
	for my $item (@items) {
		my $link = escaped($item->{link});
		my $title = escaped($item->{title});
		my $label = escaped($item->{label});
		my $date = strftime($format, gmtime $item->{date});
		$body .= qq{<item><title>$title</title><link>$link</link><guid isPermaLink="true">$link</guid><pubDate>$date</pubDate><description>$label</description></item>\n};
	}
	my $description = escaped($feed->{about});
	return <<"EOF";
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel>
<title>Yu Jie Teo: $feed->{id} feed</title>
<link>$site/$feed->{id}.html</link>
<description>$description</description>
<atom:link href="$site/$feed->{xml}" rel="self" type="application/rss+xml"/>
<lastBuildDate>$built</lastBuildDate>
$body</channel></rss>
EOF
}

sub render_page {
	my ($now, $page, @items) = @_;
	my $built = strftime('%d %b %Y, %H:%M UTC', gmtime $now);
	my $list = '';
	for my $item (@items) {
		my $link = escaped($item->{link});
		my $title = escaped($item->{title});
		my $label = escaped($item->{label});
		my $date = strftime('%Y-%m-%d', gmtime $item->{date});
		$list .= qq{<li><a href="$link" rel="noopener noreferrer"><h3>$title</h3><span class="kind">$date</span><p>$label</p></a></li>\n};
	}
	my $description = escaped($page->{about});
	return <<"EOF";
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="only light">
<link rel="icon" href="data:,">
<link rel="stylesheet" href="/style.css">
$page->{head}<title>$page->{title}</title>
<meta name="description" content="$description">
</head>
<body>
<header class="wrap"><a class="name" href="/">Yu Jie Teo</a><span class="tagline">Mechanical Engineer</span></header>
<main class="wrap"><section id="$page->{id}"><h2>$page->{title}</h2>
<p class="muted">Updated $built. $page->{note}</p>
<ol class="featured">
$list</ol></section></main>
</body>
</html>
EOF
}

# The file an AI model reads to write notes. Short fields keep it cheap to read.
sub render_text {
	my ($now, $about, $how, @items) = @_;
	my $built = strftime('%Y-%m-%d %H:%M UTC', gmtime $now);
	my $text = "# $about Built $built.\n# Columns, split by tabs: id, date, source, title, link.\n# $how The format is at $site/api/notes.txt\n";
	for my $item (@items) {
		$text .= join("\t", $item->{id}, strftime('%Y-%m-%d', gmtime $item->{date}), $item->{source}, $item->{title}, $item->{link}) . "\n";
	}
	return $text;
}

sub fetch {
	my ($url) = @_;
	if ($url =~ m{^/}) {
		open my $file, '<', $url or return '';
		local $/;
		return scalar <$file>;
	}
	return fetch_url($url, 20);
}

(my $cache = $out) =~ s{[^/]*$}{cache};
mkdir $cache unless -d $cache;

my $now = time;
my %saved_names;

# A source that fails falls back to its last good copy, saved under its cache key.
sub gather {
	my ($pause, @list) = @_;
	my $working = 0;
	my %seen;
	for my $source (@list) {
		my ($name, $url, $limit, $key) = @$source;
		sleep $pause if $pause;
		my $xml = fetch($url);
		my @items = parse($xml, $name, $limit);
		(my $saved_name = $key // $name) =~ s/[^\w.-]+/-/g;
		my $saved = "$cache/$saved_name";
		$saved_names{$saved_name} = 1;
		if (@items) {
			$working++;
			publish($saved, $xml);
		} else {
			@items = parse(fetch($saved), $name, $limit);
		}
		for my $item (@items) {
			$seen{$item->{link}} //= $item if $item->{date} <= $now;
		}
	}
	return ($working, \%seen);
}

my ($working, $seen) = gather(0, @sources);
die "feed-update: only $working of " . scalar(@sources) . " sources worked, the old feed stays\n" if $working * 2 < @sources;

# A note moves an item by one hour for each point, and its text goes first in the label.
my $notes = read_notes($notes_file);
for my $item (values %$seen) {
	my $note = $notes->{$item->{id}} or next;
	$item->{rank} = $note->{points} * 3600;
	$item->{label} = "$note->{text} · $item->{label}" if $note->{text} ne '';
}
my @sorted = sort { $b->{date} + ($b->{rank} // 0) <=> $a->{date} + ($a->{rank} // 0) || $a->{id} cmp $b->{id} } values %$seen;
splice @sorted, $max_items if @sorted > $max_items;
(my $page = $out) =~ s{[^/]*$}{reading.html};
my %reading = (
	title => 'Reading',
	id => 'reading',
	xml => 'feed.xml',
	about => $about,
	head => qq{<link rel="alternate" type="application/rss+xml" title="Reading feed" href="/feed.xml">\n},
	note => 'Newest first, moved by <a href="/api/notes.txt">notes from an AI model</a>. <a href="/feed.xml">RSS feed</a>. <a href="/reading.txt">Plain text</a>',
);
publish_gzipped($page, render_page($now, \%reading, @sorted));
publish_gzipped($out, render($now, \%reading, @sorted));
(my $reading_text = $out) =~ s{[^/]*$}{reading.txt};
publish_gzipped($reading_text, render_text($now, 'The reading feed, newest first after notes.', 'To move an item or add a sentence to it, add a line to notes/reading.tsv in github.com/yujieteo/site.', @sorted));

# Last, so a slow or failing forecaster feed cannot hold up the reading feed.
my ($forecasters_working, $forecasters_seen) = gather($forecasters_pause, @forecaster_sources);
# A LessWrong writer with no posts has an empty feed, so a low count here is no reason to stop.
my ($lesswrong_working, $lesswrong_seen) = gather($lesswrong_pause, @lesswrong_sources);
# One host serves most of the Hacker News feeds. When it is down, their last good copies fill in and health-check reports it.
die "feed-update: no forecaster feed worked, the old page stays\n" unless $forecasters_working + $lesswrong_working;
warn "feed-update: no LessWrong feed worked\n" unless $lesswrong_working;
$forecasters_seen->{$_} //= $lesswrong_seen->{$_} for keys %$lesswrong_seen;

my @forecaster_items = sort { $b->{date} <=> $a->{date} } values %$forecasters_seen;
splice @forecaster_items, $forecasters_max_items if @forecaster_items > $forecasters_max_items;
(my $forecasters_page = $out) =~ s{[^/]*$}{forecasters.html};
my %forecasters = (
	title => 'Forecasters',
	id => 'forecasters',
	xml => 'forecasters.xml',
	about => $forecasters_about,
	head => qq{<link rel="alternate" type="application/rss+xml" title="Forecasters feed" href="/forecasters.xml">\n},
	note => 'The latest from the people in the <a href="/essays/hn-forecasters/">Hacker News</a> and <a href="/essays/lw-forecasters/">LessWrong</a> forecasting rankings. <a href="/forecasts/">Forecasts to check</a>. <a href="/forecasters.xml">RSS feed</a>. <a href="/forecasters.txt">Plain text</a>. OPML of all feeds: <a href="/hn-forecasters.opml">Hacker News</a>, <a href="/lw-forecasters.opml">LessWrong</a>',
);
publish_gzipped($forecasters_page, render_page($now, \%forecasters, @forecaster_items));
(my $forecasters_xml = $out) =~ s{[^/]*$}{forecasters.xml};
publish_gzipped($forecasters_xml, render($now, \%forecasters, @forecaster_items));
(my $forecasters_text = $out) =~ s{[^/]*$}{forecasters.txt};
publish_gzipped($forecasters_text, render_text($now, 'The latest from the ranked Hacker News and LessWrong forecasters, newest first.', 'To record a forecast one of them makes, add a line to notes/forecasts.tsv in github.com/yujieteo/site.', @forecaster_items));
prune($cache, %saved_names);
