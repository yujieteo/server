#!/bin/sh
set -eu
repo=yujieteo/site
last=/home/deploy/site-commit
sha=$(ftp -MVo - "https://github.com/$repo.git/info/refs?service=git-upload-pack" 2>/dev/null | tr -d '\0' |
	sed -n 's#^[0-9a-f]\{4\}\([0-9a-f]\{40\}\) refs/heads/built$#\1#p') || exit 0
[ -n "$sha" ] && [ "$sha" != "$(cat $last 2>/dev/null)" ] || exit 0
t=$(mktemp -d)
trap 'rm -rf "$t"' EXIT
ftp -MVo "$t/site.tgz" "https://codeload.github.com/$repo/tar.gz/$sha" 2>/dev/null || exit 0
echo "$sha" > $last
mkdir "$t/x"
tar -xzf "$t/site.tgz" -C "$t/x"
new=$(echo "$t"/x/*/public)
[ -s "$new/index.html" ] || { echo "site: $sha has no public/index.html, not deployed"; exit 1; }

code() {
	printf 'GET %s HTTP/1.0\r\nHost: teoyujie.org\r\n\r\n' "$1" |
	openssl s_client -quiet -connect 127.0.0.1:443 -servername teoyujie.org 2>/dev/null | awk 'NR == 1 { print $2 }'
}
tar -czf "$t/old.tgz" -C /var/www/web/site .
tar -czf - -C "$new" . | SSH_ORIGINAL_COMMAND=site /usr/local/sbin/deploy-only
for p in / $(cat "$new/../fixed-urls.txt" 2>/dev/null); do
	c=$(code "$p")
	[ "$c" = 200 ] && continue
	SSH_ORIGINAL_COMMAND=site /usr/local/sbin/deploy-only < "$t/old.tgz"
	echo "site: $sha gave $c for $p, so the previous site is back. The next build deploys again."
	exit 1
done
