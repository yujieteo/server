from collections.abc import Iterator, Sequence
from typing import final, overload

from numpy import ndarray

type Floats = Sequence[float] | Vector | ndarray | Sequence[ndarray]

def _euler_init(self: Euler, angles: Sequence[float] = ..., order: str = ...) -> None: ...
def _euler_to_quaternion(self: Euler) -> Quaternion: ...
def _euler_to_matrix(self: Euler) -> Matrix: ...

@final
class Euler:
    x: float
    y: float
    z: float
    __init__ = _euler_init
    to_quaternion = _euler_to_quaternion
    to_matrix = _euler_to_matrix

def _quaternion_init(self: Quaternion, seq: Sequence[float] = ...) -> None: ...
def _quaternion_to_euler(self: Quaternion) -> Euler: ...
def _quaternion_normalized(self: Quaternion) -> Quaternion: ...
def _quaternion_to_matrix(self: Quaternion) -> Matrix: ...
def _quaternion_matmul(self: Quaternion, other: Vector) -> Vector: ...

@final
class Quaternion:
    w: float
    x: float
    y: float
    z: float
    __init__ = _quaternion_init
    to_euler = _quaternion_to_euler
    normalized = _quaternion_normalized
    to_matrix = _quaternion_to_matrix
    __matmul__ = _quaternion_matmul

def _vector_init(self: Vector, seq: Floats = ...) -> None: ...
def _vector_normalized(self: Vector) -> Vector: ...
def _vector_dot(self: Vector, other: Floats) -> float: ...
def _vector_cross(self: Vector, other: Floats) -> Vector: ...
def _vector_copy(self: Vector) -> Vector: ...
def _vector_lerp(self: Vector, other: Floats, factor: float) -> Vector: ...
def _vector_to_track_quat(self: Vector, track: str, up: str) -> Quaternion: ...
def _vector_add(self: Vector, other: Vector) -> Vector: ...
def _vector_sub(self: Vector, other: Vector) -> Vector: ...
def _vector_mul(self: Vector, other: float) -> Vector: ...
def _vector_rmul(self: Vector, other: float) -> Vector: ...
def _vector_truediv(self: Vector, other: float) -> Vector: ...
def _vector_neg(self: Vector) -> Vector: ...
def _vector_setitem(self: Vector, index: int, value: float) -> None: ...
@overload
def _vector_getitem(self: Vector, index: int) -> float: ...
@overload
def _vector_getitem(self: Vector, index: slice) -> Sequence[float]: ...
def _vector_len(self: Vector) -> int: ...
def _vector_iter(self: Vector) -> Iterator[float]: ...

@final
class Vector:
    x: float
    y: float
    z: float
    length: float
    __init__ = _vector_init
    normalized = _vector_normalized
    dot = _vector_dot
    cross = _vector_cross
    copy = _vector_copy
    lerp = _vector_lerp
    to_track_quat = _vector_to_track_quat
    __add__ = _vector_add
    __sub__ = _vector_sub
    __mul__ = _vector_mul
    __rmul__ = _vector_rmul
    __truediv__ = _vector_truediv
    __neg__ = _vector_neg
    __setitem__ = _vector_setitem
    __getitem__ = _vector_getitem
    __len__ = _vector_len
    __iter__ = _vector_iter

def _matrix_init(self: Matrix, rows: Sequence[Sequence[float]] = ...) -> None: ...
def _matrix_to_3x3(self: Matrix) -> Matrix: ...
def _matrix_to_4x4(self: Matrix) -> Matrix: ...
def _matrix_inverted(self: Matrix) -> Matrix: ...
def _matrix_translation_of(vec: Floats) -> Matrix: ...
def _matrix_locrotscale(loc: Vector, rot: Quaternion, scale: Vector) -> Matrix: ...
@overload
def _matrix_matmul(self: Matrix, other: Vector) -> Vector: ...
@overload
def _matrix_matmul(self: Matrix, other: Matrix) -> Matrix: ...
def _matrix_getitem(self: Matrix, index: int) -> Vector: ...
def _matrix_len(self: Matrix) -> int: ...
def _matrix_iter(self: Matrix) -> Iterator[Vector]: ...

@final
class Matrix:
    translation: Vector
    __init__ = _matrix_init
    to_3x3 = _matrix_to_3x3
    to_4x4 = _matrix_to_4x4
    inverted = _matrix_inverted
    Translation = staticmethod(_matrix_translation_of)
    LocRotScale = staticmethod(_matrix_locrotscale)
    __matmul__ = _matrix_matmul
    __getitem__ = _matrix_getitem
    __len__ = _matrix_len
    __iter__ = _matrix_iter
