#!/bin/sh
set -eu
. "$(dirname "$0")"/local.conf
usage() {
	cat >&2 <<'EOF'
usage: ./share [--days N] FILE   upload FILE and print a link with 128 random bits; it works for N days (1 to 365, default 30)
       ./share --list            show the live links and the day each one ends
       ./share --rm LINK         delete a link now (the whole link, or its 32-character id)
EOF
	exit 1
}
server=$ADMIN_USER@10.8.0.1
case ${1-} in
--list)
	[ $# -eq 1 ] || usage
	# Cron deletes a folder 30 days after its modification time.
	ssh "$server" 'cd /var/www/files/f && for p in */*; do [ -f "$p" ] || continue; m=$(stat -f %m "${p%/*}"); echo "$(date -r $((m + 2592000)) +%Y-%m-%d)  https://teoyujie.org/f/$p"; done' | sort
	exit 0 ;;
--rm)
	[ $# -eq 2 ] || usage
	d=${2#https://teoyujie.org/f/}
	d=${d%%/*}
	case $d in *[!0-9a-f]*) usage ;; *) ;; esac
	[ "${#d}" -eq 32 ] || usage
	ssh "$server" "rm -r /var/www/files/f/$d"
	exit 0 ;;
*) ;;
esac
days=30
if [ "${1-}" = --days ]; then
	[ $# -eq 3 ] || usage
	days=$2
	shift 2
fi
[ $# -eq 1 ] || usage
case $days in '' | 0* | *[!0-9]*) usage ;; *) ;; esac
[ "$days" -le 365 ] || usage
# Cron deletes a folder 30 days after its modification time, so a date in the past or future sets the lifetime.
offset=$((days - 30))
[ "$offset" -lt 0 ] || offset=+$offset
stamp=$(date -u -v"${offset}"d +%Y-%m-%dT%H:%M:%SZ)
n=$(basename "$1" | tr -d '\n' | tr -c 'A-Za-z0-9._-' _)
d=$(openssl rand -hex 16)
ssh "$server" "mkdir /var/www/files/f/$d && cat > /var/www/files/f/$d/$n && touch -d $stamp /var/www/files/f/$d" < "$1"
echo "https://teoyujie.org/f/$d/$n"
