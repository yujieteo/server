#!/bin/sh
set -eu
. "$(dirname "$0")"/local.conf
[ $# -eq 1 ] || { echo "usage: ./share FILE (copies FILE to the server, prints a link with 128 random bits that works for 30 days; to delete it sooner: ssh ADMIN_USER@10.8.0.1 rm -r /var/www/files/f/HEX)" >&2; exit 1; }
n=$(basename "$1" | tr -c 'A-Za-z0-9._\n-' _)
d=$(openssl rand -hex 16)
ssh "$ADMIN_USER"@10.8.0.1 "mkdir /var/www/files/f/$d && cat > /var/www/files/f/$d/$n" < "$1"
echo "https://teoyujie.org/f/$d/$n"
