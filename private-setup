#!/bin/sh
set -eu
cd "$(dirname "$0")"
host=${1:?usage: ./private-setup ADMIN_USER@10.8.0.1 (the one-time setup of the private names of Lavish, safe to run again; run it on the Mac, also from Termius over SSH)}
k=.ssh/tunnel_ed25519
fail() { echo "FAILED: $1. Correct it, then run ./private-setup $host again." >&2; exit 1; }

echo "1. Tunnel keys"
[ -e ~/$k ] || ssh-keygen -q -t ed25519 -N '' -C mac-tunnel -f ~/$k || fail "ssh-keygen on the Mac"
ssh desktop "[ -e ~/$k ] || ssh-keygen -q -t ed25519 -N '' -C desktop-tunnel -f ~/$k" ||
	fail "ssh desktop (the desktop must be on and on Tailscale)"

echo "2. local.conf"
[ -e local.conf ] || fail "no local.conf (README.md, Rebuild from zero, step 2)"
mac=$(cat ~/$k.pub)
desktop=$(ssh desktop "cat ~/$k.pub") || fail "read the tunnel key of the desktop"
drop_old_tunnel_key() {
	awk -v q="'" '
	s { if (substr($0, length($0)) == q) s = 0; next }
	index($0, "TUNNEL_KEY=" q) == 1 { s = index(substr($0, 13), q) == 0; next }
	index($0, "FH_TOKEN=") == 1 { next }
	{ print }' local.conf
}
drop_old_tunnel_key > local.conf.new
printf "TUNNEL_KEY='%s\n%s'\n" "$mac" "$desktop" >> local.conf.new
chmod 600 local.conf.new
mv local.conf.new local.conf

echo "3. Check the server (no install)"
./apply "$host" || fail "./apply $host"

echo "4. Dotfiles"
no_job_control=+m
no_stdin=/dev/null
zsh "$no_job_control" -ic rebuild < "$no_stdin" || fail "rebuild on the Mac (zsh -ic without $no_job_control takes the terminal and the script gets: zsh: suspended (tty output); stdin from $no_stdin keeps it from reading a later password)"
ssh -t desktop 'zsh -ic rebuild' || fail "rebuild on the desktop"
echo "Keys are set in local.conf. Follow ROLLBACK.md to install them before you use the private names."
