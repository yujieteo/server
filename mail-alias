#!/bin/sh
set -eu
cd "$(dirname "$0")"
. ./local.conf
usage() {
	echo "usage: ./mail-alias add|del NAME (changes the aliases in local.conf, then checks the server; no install), for example ./mail-alias add shop. NAME may have a to z, 0 to 9, dot, underscore and hyphen." >&2
	exit 1
}
[ $# -eq 2 ] || usage
case $1 in add | del) ;; *) usage ;; esac
case $2 in '' | *[!a-z0-9._-]*) usage ;; *) ;; esac
rest=
for a in ${ALIASES-}; do [ "$a" = "$2" ] || rest="$rest $a"; done
[ "$1" = del ] || rest="$rest $2"
ALIASES=${rest# }
sed -i '' "s/^ALIASES=.*/ALIASES='$ALIASES'/" local.conf
./apply "$ADMIN_USER"@10.8.0.1
echo "Aliases are set in local.conf. Follow ROLLBACK.md to install them."
