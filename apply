#!/bin/sh
# Run on the Mac. Copy this repo and local.conf to the server, then run install.sh there.
#   First time:  ./apply root@NEW_IP
#   After that:  ./apply ADMIN_USER@10.8.0.1
set -eu
cd "$(dirname "$0")"
host=${1:?usage: ./apply user@host}
tar --no-mac-metadata --exclude .git -czf - . | ssh "$host" 'rm -rf server && mkdir server && tar -xzf - -C server'
case $host in root@*) ssh -t "$host" sh server/install.sh ;; *) ssh -t "$host" doas sh server/install.sh ;; esac
