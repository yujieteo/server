#!/bin/sh
set -eu
cd "$(dirname "$0")"
mode=--check
checkpoint=
case ${1-} in
--install) mode=--live; checkpoint=${2:?name the full offline checkpoint}; shift 2 ;;
--bootstrap) mode=--bootstrap; shift ;;
--check) shift ;;
*) ;;
esac
host=${1:?usage: ./apply [--check | --install CHECKPOINT | --bootstrap] USER@HOST}
[ "$#" -eq 1 ] || exit 2
case ${host} in -*) exit 2 ;; *) ;; esac
case ${checkpoint} in *[!A-Za-z0-9._-]*) echo 'Use a plain checkpoint id.' >&2; exit 2 ;; *) ;; esac
work=$(mktemp -d)
trap 'rm -rf "${work}"' EXIT HUP INT TERM
umask 077
sh ./pack > "${work}/payload.tgz"
tar -tzf "${work}/payload.tgz" >/dev/null
stage=$(ssh "${host}" 'set -eu; umask 077; stage=$(mktemp -d server-stage.XXXXXXXXXX); trap '\''rm -rf "${stage}"'\'' EXIT HUP INT TERM; tar -xzf - -C "${stage}"; chmod 600 "${stage}/local.conf"; printf "%s\n" "${stage}"; trap - EXIT HUP INT TERM' < "${work}/payload.tgz")
case ${stage} in server-stage.*) ;; *) echo 'Bad stage path; no install.' >&2; exit 1 ;; esac
case ${stage} in *[!A-Za-z0-9.-]*) echo 'Bad stage path; no install.' >&2; exit 1 ;; *) ;; esac
privilege=doas
case ${host} in root@*) privilege= ;; *) ;; esac
if [ "${mode}" = --live ]; then
	[ -n "${checkpoint}" ] || exit 2
	printf 'Offline checkpoint acknowledged: %s. Restore it from the provider console if needed.\n' "${checkpoint}"
fi
remote="status=0; ${privilege} sh '${stage}/install.sh' '${mode}' || status=\$?; rm -rf '${stage}' || exit 1; exit \"\$status\""
ssh -t "${host}" "${remote}"
